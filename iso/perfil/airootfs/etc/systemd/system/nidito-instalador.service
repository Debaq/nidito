[Unit]
Description=Instalador de Nidito
ConditionKernelCommandLine=nidito.instalar
After=systemd-user-sessions.service getty-pre.target
Conflicts=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/local/bin/nidito-instalar
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
