[Unit]
Description=Instalador de Nidito
ConditionKernelCommandLine=nidito.instalar
After=systemd-user-sessions.service getty-pre.target plymouth-quit-wait.service
# Sin Conflicts=getty@tty1: systemd lo aplicaba aunque el instalador no corriera, y la sesión de
# "Probar" nunca partía (pantalla negra). getty@tty1 ya se salta solo con nidito.instalar (autologin.conf).

[Service]
Type=idle
Environment=TERM=linux
ExecStart=/usr/local/bin/nidito --instalador
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
