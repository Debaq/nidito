#!/bin/bash
# Instalador de Nidito. Se ejecuta en la consola 1 cuando se arranca la opción "Instalar".
# BORRA el disco elegido e instala una copia del sistema en vivo (sin internet).
set -u
export LANG=C.UTF-8

ROJO=$'\e[1;31m'; VERDE=$'\e[1;32m'; AMARILLO=$'\e[1;33m'; NORMAL=$'\e[0m'

titulo() { clear; echo; echo "  ${AMARILLO}==== $* ====${NORMAL}"; echo; }
apagar() { echo; read -rp "  Presiona Enter para apagar el computador... " _; systemctl poweroff; exit 0; }
fallar() {
    echo; echo "  ${ROJO}ERROR: $*${NORMAL}"
    echo "  La instalación no terminó. Puedes volver a intentarlo arrancando otra vez desde el pendrive."
    umount -R /mnt 2>/dev/null
    if [ -n "${DISCO:-}" ]; then
        echo; echo "  ${AMARILLO}--- Detalles para quien te ayude ---${NORMAL}"
        lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISCO" 2>&1 | sed 's/^/  /'
        dmesg --level=err,warn 2>/dev/null | tail -n 8 | cut -c1-110 | sed 's/^/  /'
    fi
    apagar
}
paso() { echo; echo "  ${VERDE}>>${NORMAL} $*"; }

titulo "Instalador de Nidito"
echo "  Este programa instala Nidito en el disco duro de este computador."
echo "  ${ROJO}Todo lo que hay en ese disco se va a BORRAR.${NORMAL}"
echo
echo "  (Si no quieres instalar, escribe 'no' y se apagará el computador.)"
echo

# --- disco de arranque (no se ofrece) ---
src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
disco_arranque=""
if [ -n "$src" ]; then
    pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
    disco_arranque="/dev/${pk:-$(basename "$src")}"
fi

# --- elegir disco ---
mapfile -t discos < <(lsblk -dnpo NAME,TYPE -e 7,11 | awk '$2=="disk"{print $1}' | grep -vxF "${disco_arranque:-ninguno}" | grep -v zram)
if [ ${#discos[@]} -eq 0 ]; then
    fallar "no encontré ningún disco donde instalar."
fi
echo "  Discos disponibles:"
for i in "${!discos[@]}"; do
    d=${discos[$i]}
    printf "   %d) %s  %s  %s\n" $((i + 1)) "$d" "$(lsblk -dno SIZE "$d")" "$(lsblk -dno MODEL "$d" | xargs)"
done
echo
if [ ${#discos[@]} -eq 1 ]; then
    DISCO=${discos[0]}
    read -rp "  ¿Instalar en $DISCO? (escribe 'si' o 'no'): " r
    [[ "${r,,}" == s* ]] || apagar
else
    while true; do
        read -rp "  Número del disco donde instalar: " n
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#discos[@]} ]; then
            DISCO=${discos[$((n - 1))]}
            break
        fi
        [[ "${n,,}" == no* ]] && apagar
    done
fi

echo
echo "  ${ROJO}Se borrará TODO el contenido de $DISCO ($(lsblk -dno SIZE "$DISCO")).${NORMAL}"
read -rp "  Para confirmar escribe BORRAR: " r
[ "${r^^}" = "BORRAR" ] || { echo "  No se escribió BORRAR. No se tocó nada."; apagar; }

# --- teclado ---
titulo "Teclado"
echo "   1) Latinoamericano (recomendado, el de los computadores comprados en Chile)"
echo "   2) Español de España"
read -rp "  Elige 1 o 2 [1]: " t
if [ "${t:-1}" = "2" ]; then XKB=es; KMAP=es; else XKB=latam; KMAP=la-latin1; fi

# --- clave de adultos ---
titulo "Clave de adultos"
echo "  Esta clave se pide al encender Nidito para elegir el tiempo de uso,"
echo "  y para el menú de adultos (Ctrl+Alt+P). También será la clave de 'root'."
echo "  Mínimo 4 caracteres. Mientras escribes no se ve nada: es normal."
echo
while true; do
    read -rsp "  Clave: " c1; echo
    read -rsp "  Repite la clave: " c2; echo
    if [ ${#c1} -lt 4 ]; then echo "  ${ROJO}Muy corta.${NORMAL}"; continue; fi
    if [ "$c1" != "$c2" ]; then echo "  ${ROJO}No coinciden, otra vez.${NORMAL}"; continue; fi
    CLAVE=$c1
    break
done

# --- instalar ---
titulo "Instalando Nidito"
umount -R /mnt 2>/dev/null
swapoff -a 2>/dev/null

paso "Preparando el disco $DISCO..."
# El disco puede venir con un Windows dañado: se borra todo rastro de las particiones
# viejas (firmas, tabla de particiones al inicio y al final) antes de crear la nueva.
for p in $(lsblk -lnpo NAME,TYPE "$DISCO" | awk '$2=="part"{print $1}'); do
    umount "$p" 2>/dev/null
    wipefs -af "$p" >/dev/null 2>&1
done
wipefs -af "$DISCO" >/dev/null 2>&1
TAM_MB=$(( $(blockdev --getsize64 "$DISCO") / 1048576 ))
dd if=/dev/zero of="$DISCO" bs=1M count=16 conv=fsync status=none 2>/dev/null
dd if=/dev/zero of="$DISCO" bs=1M seek=$(( TAM_MB - 16 )) count=16 conv=fsync status=none 2>/dev/null
blockdev --rereadpt "$DISCO" 2>/dev/null; udevadm settle

# Crea la partición desde INICIO (MiB), la formatea y la monta. Devuelve 1 si algo falla.
crear_particion() {
    local inicio=$1
    umount /mnt 2>/dev/null
    parted -s "$DISCO" mklabel msdos mkpart primary ext4 "${inicio}MiB" 100% set 1 boot on || return 1
    partprobe "$DISCO" 2>/dev/null; blockdev --rereadpt "$DISCO" 2>/dev/null; udevadm settle; sleep 2
    PART=$(lsblk -lnpo NAME,TYPE "$DISCO" | awk '$2=="part"{print $1; exit}')
    [ -n "$PART" ] || { echo "  No aparece la partición nueva."; return 1; }
    # Si el sistema sigue viendo la partición vieja (más chica), no sirve.
    local tam_part=$(( $(blockdev --getsize64 "$PART") / 1048576 ))
    if [ "$tam_part" -lt $(( (TAM_MB - inicio) * 9 / 10 )) ]; then
        echo "  El sistema sigue viendo la partición vieja ($tam_part MB)."; return 1
    fi
    wipefs -af "$PART" >/dev/null 2>&1
    dd if=/dev/zero of="$PART" bs=1M count=16 conv=fsync status=none 2>/dev/null
    mkfs.ext4 -F -F -q -L NIDITO "$PART" </dev/null || { echo "  No se pudo formatear $PART."; return 1; }
    sync; udevadm settle
    mount -t ext4 "$PART" /mnt || { echo "  No se pudo montar $PART."; return 1; }
}

# 1er intento al inicio normal; si falla (p. ej. sectores dañados al comienzo
# del disco), se salta el primer GB y se reintenta.
if ! crear_particion 1; then
    paso "Reintentando, saltándose el comienzo del disco..."
    crear_particion 1024 || fallar "no se pudo preparar el disco $DISCO."
fi

paso "Copiando el sistema (tarda unos minutos)..."
ORIGEN=/run/archiso/airootfs
if ! mountpoint -q "$ORIGEN"; then
    SFS=$(find /run/archiso -name 'airootfs.sfs' 2>/dev/null | head -1)
    [ -n "$SFS" ] || fallar "no encuentro la imagen del sistema."
    mkdir -p /tmp/origen && mount -o loop,ro "$SFS" /tmp/origen || fallar "no se pudo abrir la imagen del sistema."
    ORIGEN=/tmp/origen
fi
TAM=$(du -sb "$ORIGEN" 2>/dev/null | cut -f1)
tar -C "$ORIGEN" --xattrs --xattrs-include='*' --acls -cf - . | pv -s "${TAM:-0}" -p -e -w 70 | tar -C /mnt --xattrs --xattrs-include='*' --acls -xpf - || fallar "falló la copia."

paso "Copiando el kernel..."
KERNEL=$(find /run/archiso/bootmnt -name 'vmlinuz-linux' 2>/dev/null | head -1)
[ -n "$KERNEL" ] || fallar "no encuentro el kernel en el pendrive."
mkdir -p /mnt/boot && cp "$KERNEL" /mnt/boot/vmlinuz-linux

paso "Ajustando el sistema instalado..."
rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf
rm -f /mnt/etc/systemd/system/multi-user.target.wants/nidito-instalador.service /mnt/etc/systemd/system/nidito-instalador.service
cat > /mnt/etc/mkinitcpio.d/linux.preset <<'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
EOF
genfstab -U /mnt > /mnt/etc/fstab
if fallocate -l 1G /mnt/swapfile 2>/dev/null; then
    chmod 600 /mnt/swapfile && mkswap -q /mnt/swapfile && echo "/swapfile none swap defaults 0 0" >> /mnt/etc/fstab
fi
echo "KEYMAP=$KMAP" > /mnt/etc/vconsole.conf
sed -i "s/Option \"XkbLayout\" \".*\"/Option \"XkbLayout\" \"$XKB\"/" /mnt/etc/X11/xorg.conf.d/00-keyboard.conf
sed -i '/^sal=/d;/^clave=/d' /mnt/etc/nidito.conf
/usr/local/bin/nidito --hash-clave "$CLAVE" >> /mnt/etc/nidito.conf || fallar "no se pudo guardar la clave."
echo "root:$CLAVE" | chpasswd -R /mnt || fallar "no se pudo poner la clave de root."
printf 'uninitialized\n' > /mnt/etc/machine-id

paso "Preparando el arranque..."
arch-chroot /mnt mkinitcpio -P >/tmp/mkinitcpio.log 2>&1 || fallar "mkinitcpio falló (ver /tmp/mkinitcpio.log)."
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/; s/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"/' /mnt/etc/default/grub
arch-chroot /mnt grub-install --target=i386-pc "$DISCO" >/tmp/grub.log 2>&1 || fallar "no se pudo instalar el arranque (ver /tmp/grub.log)."
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg >>/tmp/grub.log 2>&1 || fallar "no se pudo configurar el arranque."

sync
umount -R /mnt

titulo "¡Listo!"
echo "  ${VERDE}Nidito quedó instalado.${NORMAL}"
echo
echo "  1. Saca el pendrive."
echo "  2. Presiona Enter: el computador se reiniciará y entrará a Nidito."
echo
echo "  Para cambiar la clave más adelante: menú de adultos (Ctrl+Alt+P) > Terminal,"
echo "  y ahí escribe:  su -c nidito-clave"
echo
read -rp "  Presiona Enter para reiniciar... " _
systemctl reboot
