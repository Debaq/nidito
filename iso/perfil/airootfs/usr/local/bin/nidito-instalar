#!/bin/bash
# Parte "de disco" del instalador de Nidito. Las pantallas y preguntas las hace `nidito --instalador`.
#
#   nidito-instalar discos     → una línea por disco donde se puede instalar: DISPOSITIVO<TAB>TAMAÑO<TAB>MODELO
#                                (nunca ofrece el pendrive desde el que se arrancó)
#   nidito-instalar instalar   → BORRA el disco e instala, usando estas variables:
#       DISCO   disco elegido (p. ej. /dev/sda)
#       XKB     teclado en X (latam, es, us)       KMAP  teclado de consola (la-latin1, es, us)
#       CLAVE   clave de adultos (también será la de root)
#       CONF    archivo con nombre=, apodo=, idioma=, juegos_min=, pausa_ojos=, cumpleanos=
#       VOZ_ES, VOZ_EN   (opcional) voces de Piper elegidas; si la ISO trae Piper, genera las frases con el nombre
#
# Salida para la interfaz: "PASO n/total texto", "PCT n" (avance de la copia), "VOZ i/n frase",
# "ERROR texto"; todo lo demás es registro.
set -u
export LANG=C.UTF-8
TOTAL=6
NIDITO=/usr/share/nidito

paso() { echo "PASO $1/$TOTAL $2"; }
fallar() {
    echo "ERROR $*"
    umount -R /mnt 2>/dev/null
    if [ -n "${DISCO:-}" ]; then
        lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISCO" 2>&1
        dmesg --level=err,warn 2>/dev/null | tail -n 8 | cut -c1-110
    fi
    exit 1
}

disco_arranque() {
    local src pk
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    [ -n "$src" ] || return 0
    pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
    echo "/dev/${pk:-$(basename "$src")}"
}

discos() {
    local arranque d
    arranque=$(disco_arranque)
    for d in $(lsblk -dnpo NAME,TYPE -e 7,11 | awk '$2=="disk"{print $1}' | grep -v zram); do
        [ "$d" = "$arranque" ] && continue
        printf '%s\t%s\t%s\n' "$d" "$(lsblk -dno SIZE "$d" | xargs)" "$(lsblk -dno MODEL "$d" | xargs)"
    done
}

# Crea la partición desde INICIO (MiB), la formatea y la monta. Devuelve 1 si algo falla.
crear_particion() {
    local inicio=$1
    umount /mnt 2>/dev/null
    parted -s "$DISCO" mklabel msdos mkpart primary ext4 "${inicio}MiB" 100% set 1 boot on || return 1
    partprobe "$DISCO" 2>/dev/null; blockdev --rereadpt "$DISCO" 2>/dev/null; udevadm settle; sleep 2
    PART=$(lsblk -lnpo NAME,TYPE "$DISCO" | awk '$2=="part"{print $1; exit}')
    [ -n "$PART" ] || { echo "No aparece la partición nueva."; return 1; }
    # Si el sistema sigue viendo la partición vieja (más chica), no sirve.
    local tam_part=$(( $(blockdev --getsize64 "$PART") / 1048576 ))
    if [ "$tam_part" -lt $(( (TAM_MB - inicio) * 9 / 10 )) ]; then
        echo "El sistema sigue viendo la partición vieja ($tam_part MB)."; return 1
    fi
    wipefs -af "$PART" >/dev/null 2>&1
    dd if=/dev/zero of="$PART" bs=1M count=16 conv=fsync status=none 2>/dev/null
    mkfs.ext4 -F -F -q -L NIDITO "$PART" </dev/null || { echo "No se pudo formatear $PART."; return 1; }
    sync; udevadm settle
    mount -t ext4 "$PART" /mnt || { echo "No se pudo montar $PART."; return 1; }
}

instalar() {
    for v in DISCO XKB KMAP CLAVE CONF; do
        [ -n "${!v:-}" ] || fallar "falta $v"
    done
    [ -b "$DISCO" ] || fallar "$DISCO no es un disco"
    [ "$DISCO" != "$(disco_arranque)" ] || fallar "$DISCO es el pendrive de instalación"

    paso 1 "disco"
    umount -R /mnt 2>/dev/null
    swapoff -a 2>/dev/null
    # El disco puede venir con un Windows dañado: se borra todo rastro de las particiones
    # viejas (firmas, tabla de particiones al inicio y al final) antes de crear la nueva.
    for p in $(lsblk -lnpo NAME,TYPE "$DISCO" | awk '$2=="part"{print $1}'); do
        umount "$p" 2>/dev/null
        wipefs -af "$p" >/dev/null 2>&1
    done
    wipefs -af "$DISCO" >/dev/null 2>&1
    TAM_MB=$(( $(blockdev --getsize64 "$DISCO") / 1048576 ))
    dd if=/dev/zero of="$DISCO" bs=1M count=16 conv=fsync status=none 2>/dev/null
    dd if=/dev/zero of="$DISCO" bs=1M seek=$(( TAM_MB - 16 )) count=16 conv=fsync status=none 2>/dev/null
    blockdev --rereadpt "$DISCO" 2>/dev/null; udevadm settle
    # 1er intento al inicio normal; si falla (p. ej. sectores dañados al comienzo
    # del disco), se salta el primer GB y se reintenta.
    if ! crear_particion 1; then
        echo "Reintentando, saltándose el comienzo del disco..."
        crear_particion 1024 || fallar "no se pudo preparar el disco $DISCO."
    fi

    paso 2 "copia"
    local origen=/run/archiso/airootfs sfs tam
    if ! mountpoint -q "$origen"; then
        sfs=$(find /run/archiso -name 'airootfs.sfs' 2>/dev/null | head -1)
        [ -n "$sfs" ] || fallar "no encuentro la imagen del sistema."
        mkdir -p /tmp/origen && mount -o loop,ro "$sfs" /tmp/origen || fallar "no se pudo abrir la imagen del sistema."
        origen=/tmp/origen
    fi
    tam=$(du -sb "$origen" 2>/dev/null | cut -f1)
    set -o pipefail
    tar -C "$origen" --xattrs --xattrs-include='*' --acls -cf - . \
        | pv -n -i 1 -s "${tam:-0}" 2> >(while read -r n; do echo "PCT $n"; done) \
        | tar -C /mnt --xattrs --xattrs-include='*' --acls -xpf - || fallar "falló la copia."
    set +o pipefail
    local kernel
    kernel=$(find /run/archiso/bootmnt -name 'vmlinuz-linux' 2>/dev/null | head -1)
    [ -n "$kernel" ] || fallar "no encuentro el kernel en el pendrive."
    mkdir -p /mnt/boot && cp "$kernel" /mnt/boot/vmlinuz-linux

    paso 3 "ajustes"
    rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf
    rm -f /mnt/etc/systemd/system/multi-user.target.wants/nidito-instalador.service /mnt/etc/systemd/system/nidito-instalador.service
    cat > /mnt/etc/mkinitcpio.d/linux.preset <<'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
EOF
    genfstab -U /mnt > /mnt/etc/fstab
    if fallocate -l 1G /mnt/swapfile 2>/dev/null; then
        chmod 600 /mnt/swapfile && mkswap -q /mnt/swapfile && echo "/swapfile none swap defaults 0 0" >> /mnt/etc/fstab
    fi
    echo "KEYMAP=$KMAP" > /mnt/etc/vconsole.conf
    grep -q '^FONT=' /etc/vconsole.conf 2>/dev/null && grep '^FONT=' /etc/vconsole.conf >> /mnt/etc/vconsole.conf
    sed -i "s/Option \"XkbLayout\" \".*\"/Option \"XkbLayout\" \"$XKB\"/" /mnt/etc/X11/xorg.conf.d/00-keyboard.conf
    # datos del niño o niña: reemplazan los de la ISO
    local k
    while IFS='=' read -r k _; do
        [[ "$k" =~ ^[a-z_]+$ ]] && sed -i "/^$k=/d" /mnt/etc/nidito.conf
    done < "$CONF"
    cat "$CONF" >> /mnt/etc/nidito.conf
    sed -i '/^sal=/d;/^clave=/d' /mnt/etc/nidito.conf
    /usr/local/bin/nidito --hash-clave "$CLAVE" >> /mnt/etc/nidito.conf || fallar "no se pudo guardar la clave."
    echo "root:$CLAVE" | chpasswd -R /mnt || fallar "no se pudo poner la clave de root."
    printf 'uninitialized\n' > /mnt/etc/machine-id

    paso 4 "voces"
    if [ -x "$NIDITO/piper/piper" ] && [ -n "${VOZ_ES:-}" ] && [ -n "${VOZ_EN:-}" ]; then
        local v=/mnt$NIDITO/voces
        [ -d "$NIDITO/voces-$VOZ_ES" ] && [ -d "$NIDITO/voces-$VOZ_EN" ] || fallar "no encuentro las voces $VOZ_ES / $VOZ_EN."
        rm -rf "$v" && mkdir -p "$v"
        cp "$NIDITO/voces-$VOZ_ES"/* "$NIDITO/voces-$VOZ_EN"/* "$v/"
        /usr/local/bin/nidito --voces-nombre /mnt/etc/nidito.conf "$v" "$NIDITO/piper" \
            "$NIDITO/modelos/$VOZ_ES.onnx" "$NIDITO/modelos/$VOZ_EN.onnx" || echo "No se pudieron generar las frases con el nombre (se usará espeak)."
        # lo que no se eligió no se necesita en el disco
        for d in /mnt$NIDITO/voces-*; do rm -rf "$d"; done
        for m in /mnt$NIDITO/modelos/*.onnx; do
            case $(basename "$m" .onnx) in "$VOZ_ES"|"$VOZ_EN") ;; *) rm -f "$m" "$m.json" ;; esac
        done
        printf 'voz_piper_es=%s\nvoz_piper_en=%s\n' "$VOZ_ES" "$VOZ_EN" >> /mnt/etc/nidito.conf
    fi

    paso 5 "arranque"
    arch-chroot /mnt mkinitcpio -P >/tmp/mkinitcpio.log 2>&1 || fallar "mkinitcpio falló (ver /tmp/mkinitcpio.log)."
    # sin menú ni espera: entra directo (Esc o Shift al encender muestran el menú)
    sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/; s/^#\?GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' /mnt/etc/default/grub
    grep -q '^GRUB_TIMEOUT_STYLE=' /mnt/etc/default/grub || echo 'GRUB_TIMEOUT_STYLE=hidden' >> /mnt/etc/default/grub
    grep -q '^GRUB_DISABLE_SUBMENU=' /mnt/etc/default/grub || echo 'GRUB_DISABLE_SUBMENU=y' >> /mnt/etc/default/grub
    sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0"/' /mnt/etc/default/grub
    arch-chroot /mnt grub-install --target=i386-pc "$DISCO" >/tmp/grub.log 2>&1 || fallar "no se pudo instalar el arranque (ver /tmp/grub.log)."
    arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg >>/tmp/grub.log 2>&1 || fallar "no se pudo configurar el arranque."

    paso 6 "fin"
    sync
    umount -R /mnt
    echo "LISTO"
}

case "${1:-}" in
    discos) discos ;;
    instalar) instalar ;;
    *) echo "uso: nidito-instalar discos | instalar   (la interfaz es: nidito --instalador)"; exit 2 ;;
esac
