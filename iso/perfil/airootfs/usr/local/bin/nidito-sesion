#!/bin/bash
# Sesión gráfica de Nidito (sin gestor de ventanas: Nidito ES el escritorio).
xset s 900 900 2>/dev/null
xset dpms 1200 1200 1200 2>/dev/null
# Controles intermedios siempre al máximo (si quedan bajos frenan todo el volumen).
for c in PCM Speaker Headphone Front; do amixer -q sset "$c" 100% unmute 2>/dev/null; done
# Volumen general: 90% la primera vez; después se respeta lo elegido en el menú de adultos (Ctrl+Alt+P).
if [ ! -f "$HOME/.config/nidito/volumen-listo2" ]; then
    amixer -q sset Master 90% unmute 2>/dev/null
    mkdir -p "$HOME/.config/nidito" && touch "$HOME/.config/nidito/volumen-listo2"
fi
# Botón de encendido: mientras Nidito está abierto, logind no apaga solo (Nidito pregunta, guarda y se despide).
# Si Nidito se cierra o falla, el bloqueo se va con él y el botón vuelve a apagar directo.
NIDITO=(/usr/local/bin/nidito)
if systemd-inhibit --what=handle-power-key --mode=block --who=Nidito --why=prueba true 2>/dev/null; then
    NIDITO=(systemd-inhibit --what=handle-power-key --mode=block --who=Nidito --why="Nidito pregunta antes de apagar" /usr/local/bin/nidito)
fi
while true; do
    "${NIDITO[@]}"
    codigo=$?
    if [ $codigo -eq 20 ]; then
        xterm -fa "DejaVu Sans Mono" -fs 13 -maximized -title "Terminal - escribe exit para volver a Nidito"
    elif [ $codigo -eq 21 ]; then
        # Menú de adultos → Actualizar: pide la clave de adultos (= root) y actualiza desde el pendrive.
        xterm -fa "DejaVu Sans Mono" -fs 13 -maximized -title "Actualizar Nidito" -e sh -c \
            'echo; echo "  Escribe la clave de adultos (no se ve mientras escribes) y Enter:"; su -c /usr/local/bin/nidito-actualizar; echo; printf "  Presiona Enter para volver a Nidito... "; read _'
    fi
    sleep 1
done
